# ══════════════════════════════════════════════════════════════════════════════
# FerrePOS — ARCHIVO ÚNICO DE CONFIGURACIÓN DE LA INSTALACIÓN
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como "ferrepos.properties" (mismo folder) y rellena tus
# propios valores. "ferrepos.properties" ya está en .gitignore: nunca lo subas
# a Git ni lo compartas, porque ahí van tus contraseñas y llaves reales.
#
# Ubicación: carpeta  config/  junto al pom.xml (o junto al .jar en producción).
# Todo lo que cambia entre una ferretería y otra vive AQUÍ.
# El resto del programa no se toca.
# ══════════════════════════════════════════════════════════════════════════════

# ─── 1. BASE DE DATOS ─────────────────────────────────────────────────────────
spring.datasource.url=jdbc:postgresql://localhost:5432/ferreteria
spring.datasource.username=postgres
spring.datasource.password=CAMBIA_ESTA_PASSWORD

# ─── 2. USUARIOS DEL SISTEMA ──────────────────────────────────────────────────
# El dueño (ADMIN): acceso total — reportes, facturación, cancelaciones, compras
app.security.admin.username=dueno
app.security.admin.password=CAMBIA_ESTA_PASSWORD
# El vendedor (SELLER): ventas, clientes, inventario
app.security.seller.username=empleado1
app.security.seller.password=CAMBIA_ESTA_PASSWORD

# ─── 3. INTELIGENCIA ARTIFICIAL (Gemini) ──────────────────────────────────────
# Genera tu key en https://aistudio.google.com/apikey y pégala aquí.
gemini.api.key=PEGA_AQUI_TU_API_KEY

# ─── 4. FACTURACIÓN CFDI (FEL Premium / Blikon) ───────────────────────────────
# "pruebas" usa app.fel.mx/CR33Test  |  "produccion" usa www.fel.mx/CR33
fel.ambiente=pruebas
# Las credenciales FEL (usuario, cuenta, password, PIN) y los datos fiscales
# del emisor viven en la tabla `empresa` de la BD.
# Ver database/Tables/empresa.sql para darlos de alta en una instalación nueva.

# ─── 5. RED ───────────────────────────────────────────────────────────────────
server.port=9090
# Orígenes permitidos para el frontend (separados por coma, sin espacios)
app.cors.allowed-origins=http://127.0.0.1:5500,http://localhost:5500

# ─── 6. IMÁGENES DE PRODUCTO ───────────────────────────────────────────────────
# Carpeta donde se guardan las fotos subidas (se crea sola). Respáldala con la BD.
app.uploads.dir=uploads

# ─── 7. SUBIDA DE ARCHIVOS (fotos de producto) ────────────────────────────────
# Por defecto Spring limita a 1 MB, pero las fotos de celular pesan 2-5 MB.
# Se sube el límite a 10 MB (el UploadController valida 6 MB por su cuenta).
spring.servlet.multipart.max-file-size=12MB
spring.servlet.multipart.max-request-size=12MB

# ─── 8. SEGURIDAD JWT (login con token) ───────────────────────────────────────
# Clave secreta para firmar los tokens. DEBE ser larga y aleatoria.
# Genera una nueva con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA la subas a Git ni la compartas. Si se filtra, cualquiera puede
# falsificar sesiones.
app.jwt.secret=GENERA_UNA_CLAVE_ALEATORIA_LARGA_AQUI
# Duración del token en milisegundos (43200000 = 12 horas)
app.jwt.expiration-ms=43200000

# Compresión automática: toda foto subida se reduce a este ancho máximo (px)
# y se guarda como JPEG con esta calidad. Una foto de celular de 5 MB queda
# en ~250 KB sin perder detalle útil. Subir estos valores = fotos más pesadas.
app.uploads.max-width=1600
app.uploads.jpeg-quality=0.88

# ─── 9. FACTURA GLOBAL (Público en General) ───────────────────────────────────
# La PERIODICIDAD (diaria / semanal / quincenal / mensual) ya NO se configura
# aquí: el dueño la cambia desde el front en Facturación → Configurar
# periodicidad (tabla configuracion_facturacion, aplica de inmediato).
# Este archivo solo controla si el timbrado automático corre o no, y a
# qué hora se revisa — la periodicidad activa decide sola qué está "cerrado".
facturaglobal.auto.enabled=true

# Hora de la revisión diaria (aplica sin importar la periodicidad elegida):
# a esta hora el sistema ve si algún periodo (día/semana/quincena/mes) ya
# cerró y tiene ventas pendientes, y si es así lo timbra solo. El SAT da
# 72 horas después del cierre del periodo, así que sobra margen.
facturaglobal.auto.cron=0 30 9 * * *
